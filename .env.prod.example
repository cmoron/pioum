# Configuration production pour NAS
# Copier vers .env.prod et remplir les valeurs

# === OBLIGATOIRE ===

# Domaine (sans https://)
DOMAIN=pioum.example.com

# Email pour Let's Encrypt
ACME_EMAIL=ton-email@example.com

# Secret JWT (générer avec: openssl rand -hex 32)
JWT_SECRET=

# Mot de passe PostgreSQL (générer avec: openssl rand -hex 16)
DB_PASSWORD=

# === AUTHENTIFICATION ===

# Google OAuth (au moins un auth requis)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === ADMIN ===

# Emails promus admin au seed (séparés par des virgules). Les comptes doivent
# déjà exister (s'être connectés au moins une fois) pour être promus.
ADMIN_BOOTSTRAP_EMAILS=

# === EMAIL (Magic Link) ===

# Resend (recommandé) — https://resend.com
RESEND_API_KEY=
# Adresse d'expéditeur (lue par le backend via EMAIL_FROM)
EMAIL_FROM="Pioum <noreply@pioum.example.com>"

# === PUSH NOTIFICATIONS ===

# Générer avec: npx web-push generate-vapid-keys
# Convertir la clé privée en JWK: node -e "const d='<PRIVATE_KEY>'; console.log(JSON.stringify({kty:'EC',crv:'P-256',d,key_ops:['sign']}))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_JWK=
VAPID_EMAIL=mailto:contact@example.com

# === OPTIONNEL ===

# SMTP pour Magic Link (fallback si pas de Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Database (valeurs par défaut OK)
DB_USER=pioum
DB_NAME=pioum
